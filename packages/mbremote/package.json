{
  "name": "mbremote",
  "version": "0.4.0",
  "description": "Command-line tools for building and flashing BBC micro:bit MicroPython and PicoRuby projects",
  "author": "ogom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogom/mbremote.git",
    "directory": "packages/mbremote"
  },
  "bugs": {
    "url": "https://github.com/ogom/mbremote/issues"
  },
  "homepage": "https://github.com/ogom/mbremote/tree/main/packages/mbremote#readme",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "src",
    "support"
  ],
  "bin": {
    "mbremote": "bin/mbremote.js"
  },
  "scripts": {
    "mbremote": "node bin/mbremote.js",
    "build": "node bin/mbremote.js build",
    "flash": "node bin/mbremote.js flash",
    "run": "node bin/mbremote.js run",
    "test": "node --test test/*.test.js",
    "test:picoruby-firmware": "node bin/mbremote.js build ../../examples/picoruby/begin --language picoruby --board v2 --firmware build/picoruby-smoke.hex",
    "prepublishOnly": "npm test && npm run test:picoruby-firmware"
  },
  "keywords": [
    "microbit",
    "micropython",
    "picoruby",
    "daplink",
    "cli"
  ],
  "dependencies": {
    "@microbit/microbit-connection": "1.0.0",
    "@microbit/microbit-fs": "0.10.0",
    "serialport": "13.0.0",
    "usb": "2.17.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
